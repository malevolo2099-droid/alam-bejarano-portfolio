---
import ProjectCard from "../components/ProjectCard.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { capabilities, experience, featuredProjects, languages, projects, software, training } from "../data/projects.js";
import responsiveAssets from "../data/responsive-assets.json";

const base = import.meta.env.BASE_URL;
const withBase = (url) => `${base}${url.replace(/^\/+/, "")}`;
const withBaseSrcset = (srcset) =>
  srcset
    ?.split(",")
    .map((candidate) => {
      const [url, ...descriptor] = candidate.trim().split(/\s+/);
      return `${withBase(url)} ${descriptor.join(" ")}`;
    })
    .join(", ");

const featured = featuredProjects.filter((project) => project.slug !== "diego-el-raton");
const archive = projects.filter((project) => ["universidad-politica", "auto-sweep", "maracumbe", "ay-inmobiliaria", "sweet-bites", "varios"].includes(project.slug));
const illustration = projects.filter((project) => project.slug === "diego-el-raton");
const portrait = responsiveAssets["/images/profile/alam-portrait.webp"];
const portraitSrcset = withBaseSrcset(portrait?.srcset);
---
<SiteLayout>
  <div class="scroll-progress" aria-hidden="true"><span class="scroll-progress__bar"></span></div>

  <section class="hero page-pad" id="inicio" aria-labelledby="hero-title">
    <div class="hero__topline">
      <span class="eyebrow">Ilustración · Identidad · Dirección creativa</span>
      <span class="hero__location">Morelia, Michoacán, México</span>
    </div>
    <h1 class="hero__title" id="hero-title">
      <span>ALAM</span>
      <span class="hero__title-bottom">BEJARANO</span>
    </h1>
    <div class="hero__lower">
      <div class="hero__descriptor">
        <p class="eyebrow">Ilustrador y Director Creativo</p>
        <p>Especialista en identidad visual<br />y narrativa gráfica.</p>
      </div>
      <p class="hero__intro">Del trazo al sistema.<br />Imagen, identidad y dirección visual en una misma práctica.</p>
      <figure class="hero__portrait">
        <img
          src={withBase("/images/profile/alam-portrait.webp")}
          srcset={portraitSrcset}
          sizes="(max-width: 640px) 58vw, (max-width: 900px) 24vw, 18vw"
          alt="Retrato de Alam Bejarano"
          fetchpriority="high"
          width={portrait?.width}
          height={portrait?.height}
        />
        <figcaption>Alam Bejarano · Morelia</figcaption>
      </figure>
      <div class="hero__actions">
        <a class="button button--dark" href="#trabajo">Ver proyectos <span aria-hidden="true">↓</span></a>
        <a class="text-link" href={withBase("/CV_Alam_Bejarano_2026.pdf")} target="_blank" rel="noreferrer">
          Descargar CV <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
    <div class="hero__foot">
      <span>Portfolio seleccionado</span>
      <span>2007 — {new Date().getFullYear()}</span>
      <a href="#trabajo">Explorar el trabajo <span aria-hidden="true">↓</span></a>
    </div>
  </section>

  <section class="intro-section page-pad section-space" aria-labelledby="intro-title">
    <div class="section-marker"><span>01</span><span>Enfoque</span></div>
    <div class="intro-section__content" data-reveal>
      <p class="eyebrow">Del trazo al sistema</p>
      <h2 id="intro-title">La imagen encuentra<br /><em>su estructura.</em></h2>
      <p class="intro-section__copy">Ilustración, identidad visual y dirección creativa: disciplinas que se encuentran en una práctica dedicada a construir y aplicar lenguajes visuales.</p>
    </div>
    <div class="intro-section__side">
      <span class="vertical-note">Imagen → Identidad → Aplicación</span>
      <span class="intro-section__symbol" aria-hidden="true">A<span>·</span>B</span>
    </div>
  </section>

  <section class="work-section page-pad section-space" id="trabajo" aria-labelledby="work-title">
    <div class="section-heading">
      <div class="section-marker"><span>02</span><span>Trabajo seleccionado</span></div>
      <h2 id="work-title">Proyectos<span class="section-heading__count">{String(projects.length).padStart(2, "0")}</span></h2>
      <p>Una selección de identidad visual, trabajo digital, producto e ilustración.</p>
    </div>
    <div class="featured-grid">
      {featured.map((project, index) => (
        <ProjectCard project={project} number={String(index + 1).padStart(2, "0")} size={index === 0 ? "large" : index === 3 || project.wideGallery ? "wide" : "regular"} />
      ))}
    </div>
    <div class="work-subsection">
      <div class="subsection-heading">
        <span class="eyebrow">04 — Ilustración / personajes</span>
        <p>Estudios de personaje y selecciones visuales.</p>
      </div>
      <div class="illustration-grid">
        {illustration.map((project, index) => (
          <ProjectCard project={project} number={`0${index + 1}`} size={index === 0 ? "illustration-feature" : "illustration"} />
        ))}
      </div>
      <p class="content-note">El material de Batman no se incluye en la versión pública por tratarse de personajes de terceros mientras no se confirme su autorización y contexto de publicación.</p>
    </div>
    <div class="work-subsection archive-section">
      <div class="subsection-heading">
        <span class="eyebrow">05 — Archivo visual</span>
        <p>Otros trabajos reunidos con atribución prudente.</p>
      </div>
      <div class="archive-list">
        {archive.map((project, index) => (
          <a class="archive-row" href={withBase(`/trabajo/${project.slug}/`)}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <strong>{project.name}</strong>
            <span>{project.category}</span>
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="trajectory-section page-pad section-space" id="trayectoria" aria-labelledby="trajectory-title">
    <div class="section-marker"><span>06</span><span>Trayectoria</span></div>
    <div class="trajectory-heading">
      <h2 id="trajectory-title">Una práctica<br /><em>en movimiento.</em></h2>
      <p>Formación, enseñanza, trabajo freelance y dirección creativa. Los periodos se muestran tal como aparecen en el CV; algunos coinciden en el tiempo.</p>
    </div>
    <div class="timeline">
      {experience.map((item, index) => (
        <article class="timeline-row" data-reveal>
          <span class="timeline-row__index">{String(index + 1).padStart(2, "0")}</span>
          <span class="timeline-row__period">{item.period}</span>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </article>
      ))}
    </div>
    <p class="content-note">El CV enumera responsabilidades de Movie Clip, pero la asociación exacta del cargo no está clara en el texto extraído.</p>
  </section>

  <section class="capabilities-section page-pad section-space" id="capacidades" aria-labelledby="capabilities-title">
    <div class="section-marker"><span>07</span><span>Capacidades</span></div>
    <div class="capabilities-heading">
      <h2 id="capabilities-title">Del trazo<br /><em>al sistema.</em></h2>
      <p>Disciplinas y conocimientos declarados en el CV.</p>
    </div>
    <div class="capabilities-list">
      {capabilities.map((group) => (
        <article class="capability-row" data-reveal>
          <span>{group.index}</span>
          <h3>{group.title}</h3>
          <p>{group.items}</p>
        </article>
      ))}
    </div>
    <div class="software-block">
      <p class="eyebrow">Herramientas declaradas en el CV</p>
      <div class="software-list">
        {software.map(([name, level]) => <span>{name}<i>{level}</i></span>)}
      </div>
    </div>
    <div class="formation-grid">
      <div>
        <p class="eyebrow">Idiomas</p>
        <div class="language-list">
          {languages.map(([name, level]) => <p><strong>{name}</strong><span>{level}</span></p>)}
        </div>
      </div>
      <div>
        <p class="eyebrow">Formación complementaria</p>
        <div class="training-list">
          {training.map((item) => <p><strong>{item.name}</strong><span>{item.detail}</span></p>)}
        </div>
      </div>
    </div>
  </section>

  <section class="cv-section page-pad" id="cv" aria-labelledby="cv-title">
    <div class="section-marker"><span>08</span><span>Documento</span></div>
    <div class="cv-section__body">
      <p class="eyebrow">Trayectoria completa</p>
      <h2 id="cv-title">El recorrido,<br /><em>en detalle.</em></h2>
      <p>Consulta o descarga el CV de Alam Bejarano.</p>
      <a class="button button--light" href={withBase("/CV_Alam_Bejarano_2026.pdf")} target="_blank" rel="noreferrer">
        Descargar CV <span aria-hidden="true">↗</span>
      </a>
    </div>
    <span class="cv-section__year">2026</span>
  </section>

  <section class="contact-section page-pad" id="contacto" aria-labelledby="contact-title">
    <div class="section-marker"><span>09</span><span>Contacto</span></div>
    <p class="eyebrow">Morelia, Michoacán, México</p>
    <h2 id="contact-title">¿Hablamos<span>?</span></h2>
    <a class="contact-email" href="mailto:identidadalamano@gmail.com">identidadalamano@gmail.com <span aria-hidden="true">↗</span></a>
    <a class="contact-phone" href="tel:+524431196109">+52 443 119 6109</a>
  </section>
</SiteLayout>