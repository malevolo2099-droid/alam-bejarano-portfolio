---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { projects, projectBySlug } from "../../data/projects.js";
import responsiveAssets from "../../data/responsive-assets.json";

const base = import.meta.env.BASE_URL;
const withBase = (url) => {
  if (!url?.startsWith("/")) return url ?? "";
  return `${base}${url.replace(/^\/+/, "")}`;
};
const withBaseSrcset = (srcset) =>
  srcset
    ?.split(",")
    .map((candidate) => {
      const [url, ...descriptor] = candidate.trim().split(/\s+/);
      return `${withBase(url)} ${descriptor.join(" ")}`;
    })
    .join(", ");

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const previous = projectBySlug[project.previous];
const next = projectBySlug[project.next];
const hasFacts = project.year || project.role;
const coverImage = responsiveAssets[project.cover];
const coverSrcset = withBaseSrcset(coverImage?.srcset);

const gallery = project.pages.map((image, index) => {
  const responsiveImage = responsiveAssets[image];

  return {
    image: withBase(image),
    index,
    responsiveSrcset: withBaseSrcset(responsiveImage?.srcset),
    responsiveImage,
    caption: project.galleryCaptions?.[index] ?? project.category,
  };
});
---
<SiteLayout
  title={`${project.name} — Alam Bejarano`}
  description={project.summary}
  image={withBase(project.cover)}
>
  <article class:list={["project-page", { "project-page--desktop-capture": project.wideGallery }]}>
    <header class="project-intro page-pad">
      <a class="back-link" href={`${base}#trabajo`}>← Volver al trabajo</a>
      <div class="project-intro__label">
        <span class="eyebrow">Proyecto seleccionado</span>
        <span class="eyebrow">{project.category}</span>
      </div>
      <h1>{project.name}</h1>
      <div class="project-intro__bottom">
        <p>{project.summary}</p>
        {hasFacts && <dl class="project-facts">
          {project.year && <div><dt>Año</dt><dd>{project.year}</dd></div>}
          {project.role && <div><dt>Rol</dt><dd>{project.role}</dd></div>}
        </dl>}
      </div>
      {project.website && <a class="text-link project-intro__website" href={project.website} target="_blank" rel="noreferrer">Visitar sitio web <span aria-hidden="true">↗</span></a>}
    </header>

    <figure class="project-hero-image">
      <img
        src={withBase(project.cover)}
        srcset={coverSrcset}
        sizes="100vw"
        width={coverImage?.width}
        height={coverImage?.height}
        alt={`Imagen principal del proyecto ${project.name}`}
        fetchpriority="high"
      />
    </figure>

    <section class="project-gallery page-pad" aria-label={`Galería del proyecto ${project.name}`}>
      <div class="gallery-heading">
        <span class="eyebrow">Material visual</span>
        <p>{project.galleryDescription ?? "Selección de imágenes disponibles en el archivo."}</p>
      </div>
      <div class:list={["project-gallery__grid", { "project-gallery__grid--wide": project.wideGallery }]}>
        {gallery.map(({ image, index, responsiveSrcset, responsiveImage, caption }) => (
          <figure class:list={["gallery-image", { "gallery-image--wide": index === 0 || index % 4 === 0 }]}>
            <img
              src={image}
              srcset={responsiveSrcset}
              sizes={project.wideGallery ? "92vw" : "(max-width: 640px) 92vw, 48vw"}
              width={responsiveImage?.width}
              height={responsiveImage?.height}
              alt={`${project.name}, ${caption}`}
              loading="lazy"
              decoding="async"
            />
            <figcaption>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <span>{caption}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    {project.note && <aside class="project-note page-pad">
      <span class="eyebrow">Nota editorial</span>
      <p>{project.note}</p>
      {project.manual && <a class="text-link" href={withBase(project.manual)} target="_blank" rel="noreferrer">{project.manualLabel} <span aria-hidden="true">↗</span></a>}
    </aside>}

    <nav class="project-pagination page-pad" aria-label="Navegación entre proyectos">
      {previous && <a href={withBase(`/trabajo/${previous.slug}/`)}><span>← Anterior</span><strong>{previous.name}</strong></a>}
      <a class="project-pagination__all" href={`${base}#trabajo`}>Todos los proyectos</a>
      {next && <a href={withBase(`/trabajo/${next.slug}/`)}><span>Siguiente →</span><strong>{next.name}</strong></a>}
    </nav>
  </article>
</SiteLayout>